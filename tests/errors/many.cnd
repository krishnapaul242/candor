  let r = [1, "x"]
  let e = []
  let h = ?what
  let c = Green
  let k = [1, 2]
  k[0] = 3
  for i in 0 ..< 3 do
    i = 4
  end for
  break
  if 1 then
    return 1
  end if
  a == 3
  bad_types(1)
  nosuch(1)
  print("x")
  return "x"
end fn bad_types

fn no_ret(c: Color) -> Int
  match c
    case Red
      return 1
  end match
end fn no_ret

fn dup_match(c: Color) -> Int
  match c
    case Red
      return 1
    case Red
      return 2
    case Blue
      return 3
    case _
      return 4
    case Green(a, b)
      return 5
  end match
end fn dup_match

fn cmp(c: Color) -> Bool
  ensures result
  example cmp(Red)
  return c == c
end fn cmp

fn print(x: Int)
end fn print

