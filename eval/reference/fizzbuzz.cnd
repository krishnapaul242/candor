fn fizzbuzz(n: Int) -> [Str]
  var out: [Str] = []
  for i in 1 ..= n do
    if i % 15 == 0 then
      push(out, "FizzBuzz")
    else if i % 3 == 0 then
      push(out, "Fizz")
    else if i % 5 == 0 then
      push(out, "Buzz")
    else
      push(out, show(i))
    end if
  end for
  return out
end fn fizzbuzz
