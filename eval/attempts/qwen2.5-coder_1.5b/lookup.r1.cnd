type Lookup = enum
  Found(index: Int)
  Missing
end type Lookup

fn index_of(names: [Str], name: Str) -> Lookup
  example index_of(["apple", "banana", "cherry"], "banana") == Found(1)
  example index_of(["apple", "banana", "cherry"], "date") == Missing
  var i = 0
  while i < len(names) do
    if names[i] == name then
      return Found(i)
    end if
    i = i + 1
  end while
  return Missing
end fn index_of
