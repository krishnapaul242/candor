fn summarize(xs: [Int]) -> Str
  requires len(xs) > 0
  example summarize([3, -1, 7]) == "count=3 sum=9 max=7"
  var total = 0
  var biggest = xs[0]
  for x in xs do
    total = total + x
    if x > biggest then
      biggest = x
    end if
  end for
  return "count=" ++ show(len(xs)) ++ " sum=" ++ show(total) ++ " max=" ++ show(biggest)
end fn summarize

fn print_summary(xs: [Int])
  effects io
  print(summarize(xs))
end fn print_summary
