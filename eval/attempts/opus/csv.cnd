fn csv_parse_int(s: Str) -> Int
  example csv_parse_int("-42") == -42
  example csv_parse_int("17") == 17
  var i = 0
  var sign = 1
  if len(s) > 0 then
    if byte_at(s, 0) == 45 then
      sign = -1
      i = 1
    end if
  end if
  var n = 0
  while i < len(s) do
    n = n * 10 + (byte_at(s, i) - 48)
    i = i + 1
  end while
  return sign * n
end fn csv_parse_int

fn parse_csv_ints(line: Str) -> [Int]
  example len(parse_csv_ints("")) == 0
  example parse_csv_ints("12,-3,40")[1] == -3
  var out: [Int] = []
  let n = len(line)
  if n == 0 then
    return out
  end if
  var start = 0
  for i in 0 ..< n do
    if byte_at(line, i) == 44 then
      push(out, csv_parse_int(slice(line, start, i)))
      start = i + 1
    end if
  end for
  push(out, csv_parse_int(slice(line, start, n)))
  return out
end fn parse_csv_ints
