fn fizzbuzz(n: Int) -> [Str]
  example len(fizzbuzz(0)) == 0
  example fizzbuzz(15)[14] == "FizzBuzz"
  var out: [Str] = []
  if n <= 0 then
    return out
  end if
  for i in 1 ..= n do
    if i % 15 == 0 then
      push(out, "FizzBuzz")
    else if i % 3 == 0 then
      push(out, "Fizz")
    else if i % 5 == 0 then
      push(out, "Buzz")
    else
      push(out, show(i))
    end if
  end for
  return out
end fn fizzbuzz
