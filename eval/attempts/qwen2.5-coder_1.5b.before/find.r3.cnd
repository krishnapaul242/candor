type Int = distinct Int

fn binary_search(xs: [Int], target: Int) -> Int
  var lo = 0
  var hi = len(xs) - 1
  while lo <= hi do
    var mid = lo + (hi - lo) // 2
    if xs[mid] == target then
      return mid
    elseif xs[mid] < target then
      lo = mid + 1
    else
      hi = mid - 1
    end if
  end while
  return -1
end fn binary_search
