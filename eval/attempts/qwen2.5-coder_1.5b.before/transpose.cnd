type Matrix = [[Int]]

fn transpose(m: Matrix) -> Matrix
  example transpose([[1, 2, 3], [4, 5, 6], [7, 8, 9]]) == [[1, 4, 7], [2, 5, 8], [3, 6, 9]]
  example transpose([]) == []
  var result = array(len(m[0]), array(len(m), 0))
  for i in 0 ..< len(m) do
    for j in 0 ..< len(m[i]) do
      result[j][i] = m[i][j]
    end for
  end for
  return result
end fn transpose
