type Instr = enum
  Push(value: Int)
  Add
  Mul
  Dup
  Swap
end type Instr

fn run(prog: [Instr]) -> Int
  var stack: [Int] = []
  for instr in prog do
    match instr
      case Push(value)
        push(stack, value)
      case Add
        let b = pop(stack)
        let a = pop(stack)
        push(stack, a + b)
      case Mul
        let b = pop(stack)
        let a = pop(stack)
        push(stack, a * b)
      case Dup
        let a = pop(stack)
        push(stack, a)
        push(stack, a)
      case Swap
        let b = pop(stack)
        let a = pop(stack)
        push(stack, b)
        push(stack, a)
    end match
  end for
  return pop(stack)
end fn run
