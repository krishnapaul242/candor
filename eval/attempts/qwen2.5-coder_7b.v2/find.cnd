fn find(xs: [Int], target: Int) -> Int
  example find([1, 2, 3, 4, 5], 3) == 2
  example find([1, 2, 3, 4, 5], 6) == -1
  var left = 0
  var right = len(xs) - 1
  while left <= right do
    var mid = (left + right) / 2
    if xs[mid] == target then
      return mid
    else if xs[mid] < target then
      left = mid + 1
    else
      right = mid - 1
    end if
  end while
  return -1
end fn find
