use "@SOL@"

fn main()
  effects io
  let xs = [1, 3, 5, 7, 9, 11]
  var parts: [Str] = []
  for t in [1, 11, 7, 4, 0, 12, 9] do
    push(parts, show(find(xs, t)))
  end for
  push(parts, show(find([], 3)))
  push(parts, show(find([5], 5)))
  push(parts, show(find([5], 6)))
  print(join(parts, " "))
end fn main
