  TIdent
  TKw
  TOp
  TInt
  TFloat
  TStr
  TNl
  TEof
end type TokKind

type NodeKind = enum
  NInt
  NFloat
  NStr
  NBool
  NHole
  NIdent
  NCall
  NRec
  NArr
  NIndex
  NField
  NUn
  NBin
  NInout
  NFieldInit
  NLet
  NAssign
  NExpr
  NIf
  NWhile
  NFor
  NMatch
  NCase
  NBindName
  NReturn
  NBreak
  NContinue
  NBlock
  NTArr
